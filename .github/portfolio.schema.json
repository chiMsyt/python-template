{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chiMsyt/python-template/blob/main/.github/portfolio.schema.json",
  "title": "Portfolio project metadata",
  "description": "Describes one repository for the portfolio website: portfolio project-metadata format, version 0.1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "summary", "status", "kind", "tracks", "stack", "links"],
  "properties": {
    "schema": {
      "description": "Version of this metadata format.",
      "const": "0.1"
    },
    "id": {
      "description": "The repository name, lowercase-kebab. Unique across the portfolio; CI checks it matches the repository.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "description": "Display name.",
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "summary": {
      "description": "One sentence: what it does and for whom.",
      "type": "string",
      "minLength": 10,
      "maxLength": 160
    },
    "status": {
      "description": "Lifecycle state shown on the website.",
      "enum": ["planned", "in-development", "active", "maintained", "stable", "experimental", "archived"]
    },
    "kind": {
      "enum": ["application", "library", "cli", "service", "extension", "game", "data-pipeline", "research", "template", "infrastructure"]
    },
    "tracks": {
      "description": "Competency tracks the implementation actually demonstrates.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "backend", "systems", "networking", "distributed-systems", "databases",
          "data-engineering", "ai-ml", "full-stack", "mobile", "infrastructure",
          "security", "developer-tooling", "performance", "embedded", "gaming", "languages"
        ]
      }
    },
    "stack": {
      "description": "Main languages, frameworks and tools, most important first.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
        "documentation": { "type": "string", "format": "uri" },
        "demo": { "type": "string", "format": "uri" },
        "case_study": { "type": "string", "format": "uri" }
      }
    },
    "highlights": {
      "description": "Up to five facts a reader can verify from the repository itself.",
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 140 }
    },
    "started": {
      "description": "Year and month the project started (YYYY-MM).",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "featured": {
      "description": "Whether the website shows the project in its featured section.",
      "type": "boolean"
    }
  }
}
